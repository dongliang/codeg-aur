pkgname=codeg-bin
pkgver=0.34.0.r3325.g7c322eb
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.34.0.r3325.g7c322eb/codeg-git-0.34.0.r3325.g7c322eb-1-x86_64.pkg.tar.zst")
sha256sums=('f8e6f346ce6e3b42686666ecee4672d06f3fea57c7e4930fe5f81d84d2fab97c')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
