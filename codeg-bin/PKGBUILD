pkgname=codeg-bin
pkgver=0.38.0.r3568.gc2f9bd2
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.38.0.r3568.gc2f9bd2/codeg-git-0.38.0.r3568.gc2f9bd2-1-x86_64.pkg.tar.zst")
sha256sums=('5e24a7f5dcd77192d80bef35dfd385158146fed216f411ca1dce70012d7714c0')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
