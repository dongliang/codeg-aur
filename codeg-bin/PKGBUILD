pkgname=codeg-bin
pkgver=0.37.0.r3549.g2ae6eaf
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.37.0.r3549.g2ae6eaf/codeg-git-0.37.0.r3549.g2ae6eaf-1-x86_64.pkg.tar.zst")
sha256sums=('ae98d1828e8cbfcf5e2753ced16a826487a5cca062604a09562a75f033d0c093')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
