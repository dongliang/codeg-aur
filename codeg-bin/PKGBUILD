pkgname=codeg-bin
pkgver=0.34.0.r3308.gfd135c8
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.34.0.r3308.gfd135c8/codeg-git-0.34.0.r3308.gfd135c8-1-x86_64.pkg.tar.zst")
sha256sums=('3f3884fa2d6b67dfc498deac7cc7f5ba44a93bcee45d19d4abc217b349e9c747')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
