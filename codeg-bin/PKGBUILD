pkgname=codeg-bin
pkgver=0.41.4.r3909.gc717cc5
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.41.4.r3909.gc717cc5/codeg-git-0.41.4.r3909.gc717cc5-1-x86_64.pkg.tar.zst")
sha256sums=('ffc714623955575f0701310207060de4881282cb2e6d0a66340c1d4ea87f4bec')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
