pkgname=codeg-bin
pkgver=0.39.0.r3703.gaa43ec4
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.39.0.r3703.gaa43ec4/codeg-git-0.39.0.r3703.gaa43ec4-1-x86_64.pkg.tar.zst")
sha256sums=('b1c7edd8895d9a53bc412a93d2befcee8eb21b3a9b58072f3eec2551338886b2')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
