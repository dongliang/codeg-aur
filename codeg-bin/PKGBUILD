pkgname=codeg-bin
pkgver=0.35.1.r3379.gaff1e6c
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.35.1.r3379.gaff1e6c/codeg-git-0.35.1.r3379.gaff1e6c-1-x86_64.pkg.tar.zst")
sha256sums=('a752c0c77a4d5d6e47ac449d8b04e5de9ba8018cc616a0a1187e013e8d5ad0ea')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
