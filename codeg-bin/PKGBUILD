pkgname=codeg-bin
pkgver=0.38.0.r3560.g7a07697
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.38.0.r3560.g7a07697/codeg-git-0.38.0.r3560.g7a07697-1-x86_64.pkg.tar.zst")
sha256sums=('885537a3a034264c549d66c75e560b2aa4550d2c9b97dd9332e82603184d93a5')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
