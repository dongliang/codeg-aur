pkgname=codeg-bin
pkgver=0.35.2.r3460.ge2a7d3d
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.35.2.r3460.ge2a7d3d/codeg-git-0.35.2.r3460.ge2a7d3d-1-x86_64.pkg.tar.zst")
sha256sums=('0707c94b25f064fa6994a88db9f53368e9120fb36b0f6e56e68b1da95c9ee1c3')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
