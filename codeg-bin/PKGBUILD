pkgname=codeg-bin
pkgver=0.36.0.r3541.g2e657fa
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.36.0.r3541.g2e657fa/codeg-git-0.36.0.r3541.g2e657fa-1-x86_64.pkg.tar.zst")
sha256sums=('e0cc1a06607a9dc0871e1f0dae73144a521e5ff5f9d9aa044b61332c94fb3905')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
