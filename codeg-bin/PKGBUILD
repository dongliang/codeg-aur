pkgname=codeg-bin
pkgver=0.42.0.r3937.ge3171d6
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.42.0.r3937.ge3171d6/codeg-git-0.42.0.r3937.ge3171d6-1-x86_64.pkg.tar.zst")
sha256sums=('2fb5415bda6dff654fb4a5588a84d6245b4f1d8772a9c82c2fa7e20ce4e8c68f')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
