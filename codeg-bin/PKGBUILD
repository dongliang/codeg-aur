pkgname=codeg-bin
pkgver=0.23.5.r2099.g3ad6f5e
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.23.5.r2099.g3ad6f5e/codeg-git-0.23.5.r2099.g3ad6f5e-1-x86_64.pkg.tar.zst")
sha256sums=('1a38736dd2820ead99a1136198bdd79bfd7ee8f98fcc6030144a6cc4c85bdd3c')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
