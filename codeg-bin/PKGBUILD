pkgname=codeg-bin
pkgver=0.34.0.r3245.g1b68ee1
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.34.0.r3245.g1b68ee1/codeg-git-0.34.0.r3245.g1b68ee1-1-x86_64.pkg.tar.zst")
sha256sums=('c958cbf93c3cb08d8ab29686ddf2fe61d80e4317921fc58269290eee45d18a48')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
