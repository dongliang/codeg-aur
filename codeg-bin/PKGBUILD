pkgname=codeg-bin
pkgver=0.42.2.r3965.gd658b4c
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.42.2.r3965.gd658b4c/codeg-git-0.42.2.r3965.gd658b4c-1-x86_64.pkg.tar.zst")
sha256sums=('d8612ba3c33ba10b2b7a09b0dd44ce14ad85d1ef905df3b1577ba7430f28e5f4')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
