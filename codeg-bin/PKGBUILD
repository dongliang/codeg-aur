pkgname=codeg-bin
pkgver=0.34.0.r3338.ga1a4ccf
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.34.0.r3338.ga1a4ccf/codeg-git-0.34.0.r3338.ga1a4ccf-1-x86_64.pkg.tar.zst")
sha256sums=('bf4c2f5d1aba01811dd11f55b80b0716d3801fcc67158a90e37d8feaa10e6cd3')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
