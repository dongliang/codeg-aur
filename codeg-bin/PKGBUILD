pkgname=codeg-bin
pkgver=0.35.1.r3401.g08baa41
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc. (prebuilt)"
arch=('x86_64')
url="https://github.com/dongliang/codeg-aur"
license=('Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
conflicts=('codeg' 'codeg-git')
provides=('codeg')
source=("https://github.com/dongliang/codeg-aur/releases/download/v0.35.1.r3401.g08baa41/codeg-git-0.35.1.r3401.g08baa41-1-x86_64.pkg.tar.zst")
sha256sums=('b8a7f53eee551b1bec8b2ab0e32d4161330d5cbb8d48cfb67e4cce9e597976ad')

package() {
  bsdtar -x -f "$srcdir"/*.pkg.tar.zst -C "$pkgdir" usr
  ln -s codeg-git "$pkgdir/usr/share/licenses/codeg-bin"
}
