# Maintainer: dongliang <dongliang17@gmail.com>
# Contributor: feitao (upstream)

pkgname=codeg-git
pkgver=0.23.5.r2077.gaa0c4d6
pkgrel=1
pkgdesc="Collaborative multi-agent AI coding workspace: aggregate sessions from Claude Code, Codex, OpenCode, Pi, Grok Build, etc."
arch=('x86_64')
url="https://github.com/xintaofei/codeg"
license=('Apache-2.0')
options=('!lto')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'librsvg'
  'libsecret'
  'openssl'
)
makedepends=(
  'base-devel'
  'rust'
  'nodejs'
  'pnpm'
  'git'
)
conflicts=('codeg' 'codeg-bin')
provides=('codeg')
source=("codeg::git+https://github.com/xintaofei/codeg.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/codeg"
  local _ver _rev _hash
  _ver="$(node -p "require('./src-tauri/tauri.conf.json').version")"
  _rev="$(git rev-list --count HEAD)"
  _hash="$(git rev-parse --short=7 HEAD)"
  printf '%s.r%s.g%s' "$_ver" "$_rev" "$_hash"
}

prepare() {
  cd "$srcdir/codeg"
  pnpm install --frozen-lockfile
}

build() {
  cd "$srcdir/codeg"
  export HUSKY=0
  pnpm tauri build --no-bundle
}

package() {
  cd "$srcdir/codeg/src-tauri"
  install -Dm755 target/release/codeg "$pkgdir/usr/bin/codeg"
  install -Dm755 target/release/codeg-mcp "$pkgdir/usr/bin/codeg-mcp"
  install -Dm755 target/release/codeg-server "$pkgdir/usr/bin/codeg-server"

  install -Dm644 icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/codeg.png"
  install -Dm644 icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/codeg.png"
  install -Dm644 icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/codeg.png"

  install -Dm644 "$srcdir/codeg/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/codeg.desktop" <<'EOF'
[Desktop Entry]
Categories=Development;IDE;
Comment=Agent Code Generation App
Exec=/usr/bin/codeg
Icon=codeg
Name=codeg
StartupWMClass=codeg
Terminal=false
Type=Application
EOF
  chmod 644 "$pkgdir/usr/share/applications/codeg.desktop"
}
